# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Yandex Maps / MapKit API Key
VITE_YANDEX_MAPS_API_KEY=""

# Supabase (PostgreSQL & Realtime & Auth)
VITE_SUPABASE_URL=""
