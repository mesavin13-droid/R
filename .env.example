# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Yandex Maps / MapKit API Key
VITE_YANDEX_MAPS_API_KEY=""

# Supabase (PostgreSQL & Realtime & Auth)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Server-only Supabase service role key. Never expose as VITE_*.
SUPABASE_SERVICE_ROLE_KEY=""
# Optional server-side Supabase URL; falls back to VITE_SUPABASE_URL.
SUPABASE_URL=""

# Map Provider (defaults to yandex, falls back to osm)
VITE_MAP_PROVIDER="yandex"

# Telegram Bot & Mini App
VITE_TELEGRAM_BOT_USERNAME=""
# Server-only secret. Never expose TELEGRAM_BOT_TOKEN as a VITE_* variable.
TELEGRAM_BOT_TOKEN=""
# Lifetime of the server-issued Telegram session in seconds.
TELEGRAM_SESSION_TTL_SECONDS="86400"

# Web Push (VAPID)
VITE_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@roadlive.app"

# Demo-only local login. Keep false/empty in production.
VITE_ENABLE_DEMO_AUTH="false"

# Server-side Telegram admin allowlist. Never trust a client-provided role.
ROADLIVE_ADMIN_TELEGRAM_IDS=""
